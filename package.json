{
  "name": "vortex-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Editor profissional de vídeo, áudio e motion graphics com biblioteca de conteúdo integrada",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "serve": "node netlify/dev-server.mjs 8888",
    "local": "npm run build && node netlify/dev-server.mjs 8888",
    "vercel:dev": "npm run build && node vercel-dev.mjs 3001",
    "vercel:api": "node vercel-dev.mjs 3001"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "netlify-cli": "^17.38.1",
    "playwright": "^1.49.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.5"
  }
}
